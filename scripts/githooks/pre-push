#!/bin/sh
# The full suite, ~9s -- once per push rather than once per commit.
# Postgres is skipped unless RUNSTATE_TEST_PG_DSN is set, so this is a WEAKER
# gate than CI, which runs it: ~215 tests are skipped here that CI executes.
#
# Bypass with `git push --no-verify`.
. "$(git rev-parse --show-toplevel)/scripts/githooks/_common.sh"
echo "pre-push:"
run_gate "pytest" pytest tests/ -q || exit 1
[ -n "$RUNSTATE_TEST_PG_DSN" ] || echo "  note  postgres suite skipped locally; CI runs it"

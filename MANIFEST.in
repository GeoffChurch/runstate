# sdist contents beyond the package itself. The wheel is unaffected -- these
# trees live OUTSIDE the `runstate` package, so they ship in the source
# distribution only. The wheel is the Python implementation and does not read
# the schemas (docs/specs/release-and-stability.md, "Schemas").

include CHANGELOG.md
include LICENSE

# The wire-authoritative source of truth travels with the source: every
# registered log format's schemas, in protocol/v<format>/.
recursive-include protocol *.json

# The design record and the runnable examples. (The migration steps ship in the
# package, runstate/migrations/; scripts/ holds development tools only.)
recursive-include docs *.md
recursive-include examples *.py

# Never ship build/cache droppings.
global-exclude *.py[cod]
global-exclude __pycache__
prune **/__pycache__
